<Window x:Class="GuardianLicenseManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Guardian License Manager" Height="850" Width="1440" MinHeight="700" MinWidth="1120" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
<Grid Margin="28">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,24">
<StackPanel Orientation="Horizontal"><Border Width="46" Height="46" CornerRadius="14" Background="#7659F5"><TextBlock Text="G" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="GUARDIAN" FontSize="18" FontWeight="Bold" LetterSpacing="2"/><TextBlock Text="LICENSE MANAGER  ·  ADMIN CONSOLE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="연결되지 않음" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ConnectButton" Content="서버 연결" Click="Connect_Click"/></StackPanel>
</DockPanel>
<Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,18">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="API 서버 주소" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="ApiUrlBox" Text="https://licenses.example.com" Margin="0,5,16,0"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="관리자 토큰" Foreground="{StaticResource MutedBrush}" FontSize="11"/><PasswordBox x:Name="TokenBox" Background="#0C1728" Foreground="White" BorderBrush="#344966" Padding="11,9" Margin="0,5,16,0"/></StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Bottom"><TextBlock Text="토큰은 앱 메모리에만 보관됩니다." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,8"/><Button Content="연결 해제" Background="#293A56" Click="Disconnect_Click"/></StackPanel>
</Grid></Border>
<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18">
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Width="220" Margin="0,0,12,0"><StackPanel><TextBlock Text="전체 라이선스" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalCount" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Width="220" Margin="0,0,12,0"><StackPanel><TextBlock Text="사용 가능" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActiveCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#49D7A5" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Width="220" Margin="0,0,12,0"><StackPanel><TextBlock Text="만료" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExpiredCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#F3C66B" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Width="220"><StackPanel><TextBlock Text="정지" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RevokedCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#FF8191" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,16,0">
<StackPanel><TextBlock Text="새 라이선스 발급" FontSize="18" FontWeight="Bold"/><TextBlock Text="고객 및 이용 조건을 입력하세요." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,18"/>
<TextBlock Text="고객명" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="CustomerNameBox"/>
<TextBlock Text="이메일" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="CustomerEmailBox"/>
<TextBlock Text="주문번호 (선택)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrderRefBox"/>
<TextBlock Text="이용 기간" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="PlanBox" SelectedIndex="2"><ComboBoxItem Content="7일 체험" Tag="short_7d"/><ComboBoxItem Content="30일 월간" Tag="monthly_30d"/><ComboBoxItem Content="90일 분기" Tag="quarterly_90d"/><ComboBoxItem Content="365일 연간" Tag="annual_365d"/></ComboBox>
<TextBlock Text="허용 기기 수" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="DeviceCountBox" SelectedIndex="0"><ComboBoxItem Content="1대" Tag="1"/><ComboBoxItem Content="2대" Tag="2"/><ComboBoxItem Content="3대" Tag="3"/><ComboBoxItem Content="5대" Tag="5"/><ComboBoxItem Content="10대" Tag="10"/></ComboBox>
<Button Content="라이선스 발급" Click="Issue_Click" Margin="0,8,0,0"/>
<Border x:Name="IssuedPanel" Background="#0C1728" BorderBrush="#3B5273" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="발급된 라이선스 키 · 최초 1회 표시" Foreground="#49D7A5" FontSize="11"/><TextBox x:Name="IssuedKeyBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8"/><Button Content="키 복사" Background="#293A56" Click="CopyKey_Click"/></StackPanel></Border>
</StackPanel></Border>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="라이선스 관리" FontSize="18" FontWeight="Bold"/><TextBlock Text="발급 현황과 고객 라이선스를 관리합니다." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="새로고침" Background="#293A56" Click="Refresh_Click"/></DockPanel>
<DataGrid x:Name="LicenseGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single">
<DataGrid.Columns><DataGridTextColumn Header="고객 / 라이선스 ID" Binding="{Binding DisplayRef}" Width="2*"/><DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="*"/><DataGridTextColumn Header="만료일" Binding="{Binding ExpiresLabel}" Width="1.4*"/><DataGridTextColumn Header="기기" Binding="{Binding DeviceLabel}" Width="*"/><DataGridTemplateColumn Header="관리" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="정지" Padding="10,5" Background="#7B3548" Click="Revoke_Click" Tag="{Binding Id}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
</DataGrid></Grid></Border>
</Grid>
<TextBlock Grid.Row="4" x:Name="StatusText" Text="서버 주소와 관리자 토큰을 입력한 뒤 연결하세요." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,14,0,0"/>
</Grid></Window>