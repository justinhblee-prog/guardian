<Window x:Class="GuardianLicenseManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Guardian License Manager" Height="620" Width="820" MinHeight="540" MinWidth="700" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen" Icon="{StaticResource GuardianWindowIcon}">
<Grid Margin="14">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,14">
<StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="12" Background="#101C2C"><Image Source="{StaticResource GuardianWindowIcon}" Margin="2"/></Border><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="GUARDIAN" FontSize="18" FontWeight="Bold"/><TextBlock Text="LICENSE MANAGER  ·  ADMIN CONSOLE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="제품 업데이트" Background="#365B83" Click="Updates_Click" Margin="0,0,10,0"/><TextBlock x:Name="ConnectionLabel" Text="연결되지 않음" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="ConnectButton" Content="서버 연결" Click="Connect_Click"/></StackPanel>
</DockPanel>
<Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="API 서버 주소" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="ApiUrlBox" Text="" ToolTip="실제 운영 License API의 HTTPS 주소를 입력하세요. licenses.example.com은 예시 주소이며 실제 서버가 아닙니다." Margin="0,5,16,0"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="관리자 토큰" Foreground="{StaticResource MutedBrush}" FontSize="11"/><PasswordBox x:Name="TokenBox" Background="#0C1728" Foreground="White" BorderBrush="#344966" Padding="11,9" Margin="0,5,16,0"/></StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Bottom"><TextBlock Text="토큰은 앱 메모리에만 보관됩니다." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,8"/><Button Content="연결 해제" Background="#293A56" Click="Disconnect_Click"/></StackPanel>
</Grid></Border>
<Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="전체 라이선스" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="TotalCount" Text="—" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="사용 가능" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ActiveCount" Text="—" FontSize="26" FontWeight="Bold" Foreground="#49D7A5" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="만료" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ExpiredCount" Text="—" FontSize="26" FontWeight="Bold" Foreground="#F3C66B" Margin="0,6,0,0"/></StackPanel></Border>
<Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="정지" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="RevokedCount" Text="—" FontSize="26" FontWeight="Bold" Foreground="#FF8191" Margin="0,6,0,0"/></StackPanel></Border>
</Grid>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,12,0">
<StackPanel><TextBlock Text="새 라이선스 발급" FontSize="18" FontWeight="Bold"/><TextBlock Text="고객 및 이용 조건을 입력하세요." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,18"/>
<TextBlock Text="고객명" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="CustomerNameBox"/>
<TextBlock Text="이메일" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="CustomerEmailBox"/>
<TextBlock Text="주문번호 (선택)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrderRefBox"/>
<TextBlock Text="이용 기간" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="PlanBox" SelectedIndex="2" SelectionChanged="PlanBox_SelectionChanged" Background="#F3F6FB" Foreground="#132238" ToolTip="라이선스가 유효한 이용 기간을 선택합니다.">
<ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Content}" Foreground="#132238" Background="#F3F6FB"/></DataTemplate></ComboBox.ItemTemplate>
<ComboBoxItem Content="7일 체험" Tag="short_7d" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="30일 월간" Tag="monthly_30d" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="90일 분기" Tag="quarterly_90d" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="365일 연간" Tag="annual_365d" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="직접 입력" Tag="custom" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="영구 이용 · PERMANENT" Tag="permanent" Foreground="#132238" Background="#F3F6FB"/></ComboBox>
<StackPanel x:Name="CustomDaysPanel" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock Text="직접 이용 기간 (일)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="CustomDaysBox" Text="365" ToolTip="1~36500일 사이의 이용 기간을 입력하세요." Background="#F3F6FB" Foreground="#132238"/></StackPanel>
<TextBlock Text="허용 기기 수" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="DeviceCountBox" SelectedIndex="0" Background="#F3F6FB" Foreground="#132238" ToolTip="이 라이선스 키를 활성화할 수 있는 최대 기기 수입니다.">
<ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Content}" Foreground="#132238" Background="#F3F6FB"/></DataTemplate></ComboBox.ItemTemplate>
<ComboBoxItem Content="1대" Tag="1" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="2대" Tag="2" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="3대" Tag="3" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="5대" Tag="5" Foreground="#132238" Background="#F3F6FB"/><ComboBoxItem Content="10대" Tag="10" Foreground="#132238" Background="#F3F6FB"/></ComboBox>
<Button Content="라이선스 발급" ToolTip="위에 입력한 고객·기간·기기 수로 새 라이선스를 발급합니다." Click="Issue_Click" Margin="0,8,0,0"/>
<Border x:Name="IssuedPanel" Background="#0C1728" BorderBrush="#3B5273" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="발급된 라이선스 키 · 최초 1회 표시" Foreground="#49D7A5" FontSize="11"/><TextBox x:Name="IssuedKeyBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8"/><Button Content="발급 키 복사" ToolTip="방금 발급된 라이선스 키를 클립보드에 복사합니다." Background="#293A56" Click="CopyKey_Click"/></StackPanel></Border>
</StackPanel></Border></ScrollViewer>
<Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="라이선스 관리" FontSize="18" FontWeight="Bold"/><TextBlock Text="발급 현황과 고객 라이선스를 관리합니다." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="목록 새로고침" ToolTip="서버에서 라이선스 목록과 상태를 다시 불러옵니다." Background="#293A56" Click="Refresh_Click"/></DockPanel>
<DataGrid x:Name="LicenseGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single">
<DataGrid.Columns><DataGridTextColumn Header="고객 / 라이선스 ID" Binding="{Binding DisplayRef}" Width="2*"/><DataGridTextColumn Header="상태" Binding="{Binding StatusLabel}" Width="*"/><DataGridTextColumn Header="만료일" Binding="{Binding ExpiresLabel}" Width="1.4*"/><DataGridTextColumn Header="기기" Binding="{Binding DeviceLabel}" Width="*"/><DataGridTemplateColumn Header="관리" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="라이선스 정지" ToolTip="선택된 고객 라이선스를 즉시 정지합니다." Padding="10,5" Background="#7B3548" Click="Revoke_Click" Tag="{Binding Id}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
</DataGrid></Grid></Border>
</Grid>
<TextBlock Grid.Row="4" x:Name="StatusText" Text="서버 주소와 관리자 토큰을 입력한 뒤 연결하세요." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,14,0,0"/>
</Grid></Window>