<Application x:Class="GuardianLicenseManager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#121E31"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#263852"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#94A7C2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7659F5"/>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C1728"/><Setter Property="Foreground" Value="#F1F5FC"/><Setter Property="BorderBrush" Value="#344966"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#0C1728"/><Setter Property="Foreground" Value="#F1F5FC"/><Setter Property="BorderBrush" Value="#344966"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#7659F5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#121E31"/><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="BorderBrush" Value="#263852"/><Setter Property="RowBackground" Value="#142238"/><Setter Property="AlternatingRowBackground" Value="#101B2D"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
  </Application.Resources>
</Application>