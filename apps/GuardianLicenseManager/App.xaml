<Application x:Class="GuardianLicenseManager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <DrawingImage x:Key="GuardianWindowIcon"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#0B1525" Geometry="M0,0 H108 V108 H0 Z"/>
      <GeometryDrawing Brush="#48DCAE" Geometry="M54,8 L88,20 L85,57 C82,78 68,91 54,99 C40,91 26,78 23,57 L20,20 Z"/>
      <GeometryDrawing Brush="#0A101E" Geometry="M54,17 L79,26 L77,56 C75,73 64,84 54,90 C44,84 33,73 31,56 L29,26 Z"/>
      <GeometryDrawing Brush="#48DCAE" Geometry="M69,39 C64,34 57,32 50,34 C39,37 33,47 35,58 C37,69 47,76 58,73 C65,71 70,66 72,59 L58,59 L58,51 L82,51 L82,56 C82,73 70,85 54,85 C37,85 25,73 25,56 C25,39 38,26 55,26 C64,26 72,30 78,36 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <SolidColorBrush x:Key="PageBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#121E31"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#263852"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#94A7C2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7659F5"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0C1728"/>
      <Setter Property="Foreground" Value="#F1F5FC"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#7659F5"/>
      <Setter Property="BorderBrush" Value="#344966"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#0C1728"/>
      <Setter Property="Foreground" Value="#F1F5FC"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#344966"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0C1728"/>
      <Setter Property="Foreground" Value="#F1F5FC"/>
      <Setter Property="BorderBrush" Value="#526783"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#293D5B"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#3B3470"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#718096"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#7659F5"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,4,8,4"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.9"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#121E31"/>
      <Setter Property="Foreground" Value="#EAF0FA"/>
      <Setter Property="BorderBrush" Value="#263852"/>
      <Setter Property="RowBackground" Value="#142238"/>
      <Setter Property="AlternatingRowBackground" Value="#101B2D"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#263852"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="ColumnHeaderHeight" Value="38"/>
      <Setter Property="RowHeight" Value="42"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1B2B43"/>
      <Setter Property="Foreground" Value="#DCE7F7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#344966"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#EAF0FA"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,5"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF"/>
          <Setter Property="Background" Value="#3B3470"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="#EAF0FA"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#3B3470"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>