<Window x:Class="GuardianLicenseManager.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardian 제품 업데이트 관리" Height="660" Width="860"
        MinHeight="560" MinWidth="700" WindowStartupLocation="CenterOwner"
        Background="#0B1424" Foreground="#F1F6FF">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="제품 업데이트 관리" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Android / Windows 배포 버전과 SHA-256을 관리합니다. 설치 파일은 HTTPS 배포 저장소에 먼저 올린 뒤 다운로드 주소를 등록하세요." Foreground="#9FB0C8" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#142238" BorderBrush="#30445F" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="플랫폼" Foreground="#A9B8CC"/><ComboBox x:Name="PlatformBox" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="Android" Tag="android"/><ComboBoxItem Content="Windows" Tag="windows"/></ComboBox></StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"><TextBlock Text="배포 채널" Foreground="#A9B8CC"/><ComboBox x:Name="ChannelBox" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="정식 (Stable)" Tag="stable"/><ComboBoxItem Content="베타 (Beta)" Tag="beta"/></ComboBox></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="버전 (예: 1.2.0)" Foreground="#A9B8CC"/><TextBox x:Name="VersionBox" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"><TextBlock Text="최소 지원 버전 (선택)" Foreground="#A9B8CC"/><TextBox x:Name="MinVersionBox" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8"><TextBlock Text="HTTPS 다운로드 주소" Foreground="#A9B8CC"/><TextBox x:Name="DownloadUrlBox" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8"><TextBlock Text="SHA-256 (64자리)" Foreground="#A9B8CC"/><TextBox x:Name="Sha256Box" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="릴리스 노트" Foreground="#A9B8CC"/><TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/></StackPanel>
        <DockPanel Grid.ColumnSpan="2" Grid.Row="5" Margin="0,10,0,0">
          <CheckBox x:Name="MandatoryBox" Content="필수 업데이트 (최소 지원 버전 미만 차단)" Foreground="#F1F6FF" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="버전 등록 / 게시" Background="#287A66" Click="Publish_Click" Padding="18,9" Margin="8,0,0,0"/><Button Content="목록 새로고침" Background="#344966" Click="Refresh_Click" Padding="18,9" Margin="8,0,0,0"/></StackPanel>
        </DockPanel>
      </Grid>
    </Border>
    <DataGrid x:Name="UpdateGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="플랫폼" Binding="{Binding PlatformLabel}" Width="*"/>
        <DataGridTextColumn Header="채널" Binding="{Binding ChannelLabel}" Width="*"/>
        <DataGridTextColumn Header="버전" Binding="{Binding Version}" Width="*"/>
        <DataGridTextColumn Header="최소 지원" Binding="{Binding MinVersionLabel}" Width="*"/>
        <DataGridCheckBoxColumn Header="필수" Binding="{Binding Mandatory}" Width="55"/>
        <DataGridTextColumn Header="게시일" Binding="{Binding PublishedLabel}" Width="1.5*"/>
        <DataGridTextColumn Header="다운로드 주소" Binding="{Binding DownloadUrl}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="StatusText" Grid.Row="3" Text="제품 업데이트 서버에 연결되었습니다." Foreground="#A9B8CC" Margin="2,12,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>