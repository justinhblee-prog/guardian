{
  "manifest_version": 3,
  "name": "Guardian AdBlock",
  "description": "Domain-based ad and tracker blocking powered by Guardian shared rules.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Guardian AdBlock" }
}
