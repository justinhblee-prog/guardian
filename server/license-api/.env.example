# Copy to .env and replace every placeholder with unique production secrets.
# Use a URL-safe alphanumeric PostgreSQL password (at least 32 random characters).
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_ALPHANUMERIC_CHARACTERS

# Generate independently; do not reuse the database password.
GUARDIAN_ADMIN_TOKEN=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
GUARDIAN_LICENSE_LOOKUP_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS

# RSA 2048-bit or stronger PKCS#8 PEM private key. Keep escaped newlines as \n.
# Never commit the real key or put it in the Android application.
GUARDIAN_LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_BASE64_KEY_MATERIAL\n-----END PRIVATE KEY-----


# Google Play Billing: inject this JSON from Secret Manager in production.
# The private_key field must contain escaped \n sequences; never commit real credentials.
GOOGLE_PLAY_PACKAGE_NAME=com.guardian.adblock
GOOGLE_PLAY_PRODUCT_IDS=guardian_pro_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Exact audience configured on the authenticated Pub/Sub push subscription.
GOOGLE_PLAY_RTDN_AUDIENCE=
# User-managed service account email attached to the Pub/Sub push subscription.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Optional. Defaults shown.
PORT=8787
GUARDIAN_RATE_LIMIT_WINDOW_MS=60000
GUARDIAN_RATE_LIMIT_MAX=30
