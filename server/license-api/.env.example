# Copy to .env and replace every placeholder with unique production secrets.
# Use a URL-safe alphanumeric PostgreSQL password (at least 32 random characters).
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_ALPHANUMERIC_CHARACTERS

# Optional legacy override. Leave unset to auto-generate a token on first API startup;
# only its SHA-256 verifier is stored in PostgreSQL and it survives restarts.
# GUARDIAN_ADMIN_TOKEN=
GUARDIAN_LICENSE_LOOKUP_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS

# RSA 2048-bit or stronger PKCS#8 PEM private key. Keep escaped newlines as \n.
# Never commit the real key or put it in the Android application.
GUARDIAN_LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_BASE64_KEY_MATERIAL\n-----END PRIVATE KEY-----

# Optional. Defaults shown.
PORT=8787
GUARDIAN_RATE_LIMIT_WINDOW_MS=60000
GUARDIAN_RATE_LIMIT_MAX=30
