<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Sideloaded direct distribution only. The GitHub stable updater downloads
        a signed APK and opens Android's user-confirmed package installer.
        This permission is deliberately absent from the Google Play release variant.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The optional foreground-app compatibility feature needs Usage Access only in the sideloaded build. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
</manifest>
